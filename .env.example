# ===========================================
# IPTV Manager - Environment Configuration
# ===========================================
# Copy this file to .env and fill in all values
# NEVER commit the .env file to version control

# ---- General ----
NODE_ENV=production
APP_NAME=iptv-manager
APP_URL=https://iptv.kukey.com
PUBLIC_URL=https://kukey.com

# ---- Database ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iptv_manager
POSTGRES_USER=iptv_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ---- JWT ----
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_REFRESH
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_PLAYLIST_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_PLAYLIST

# ---- TOTP / 2FA ----
TOTP_ISSUER=IPTVManager
TOTP_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX_KEY

# ---- Session ----
SESSION_SECRET=CHANGE_ME_STRONG_SESSION_SECRET
COOKIE_DOMAIN=iptv.kukey.com
COOKIE_SECURE=true

# ---- Security ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=900
BCRYPT_ROUNDS=12
CORS_ORIGIN=https://iptv.kukey.com

# ---- SSRF Protection ----
FETCH_TIMEOUT_MS=15000
FETCH_MAX_SIZE_MB=50
FETCH_MAX_REDIRECTS=3

# ---- Health Check ----
HEALTH_CHECK_CONCURRENCY=10
HEALTH_CHECK_TIMEOUT_MS=10000
HEALTH_CHECK_INTERVAL_MINUTES=60
HEALTH_CHECK_RETRY_COUNT=3
HEALTH_CHECK_AUTO_DISABLE_AFTER=5

# ---- Workers ----
WORKER_CONCURRENCY=5
PLAYLIST_REFRESH_CRON=0 */6 * * *
CLEANUP_CRON=0 3 * * *

# ---- Logging ----
LOG_LEVEL=info
LOG_DIR=/app/logs

# ---- Optional: Notifications ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# ---- Optional: Cloudflare ----
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# ---- Docker Build ----
COMPOSE_PROJECT_NAME=iptv-manager
